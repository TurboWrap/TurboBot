# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here
BOT_PREFIX=!

# Bot Settings
BOT_NAME=TurboBot
BOT_DESCRIPTION=A moderation bot for TurboWrap communities

# Moderation Settings
MODERATION_ENABLED=true
LOG_CHANNEL=moderation-logs
MOD_ROLE=Moderator

# Database Settings (optional)
DATABASE_URL=sqlite:///turbobot.db

# Logging
LOG_LEVEL=INFO
